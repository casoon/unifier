---
import {
  Badge,
  Badges,
  Button,
  CodeBlock,
  Facts,
  Features,
  Hero,
  Install,
  Quickstart,
} from '@casoon/pages-theme/components';
import Base from '@casoon/pages-theme/layouts/Base.astro';
import config from 'virtual:casoon-pages/config';
import { url } from '@casoon/pages-theme/url';
// Animated SVG built with castwright from site/captures/job-shop.terminal.yaml: the captured
// output of the job_shop example in examples/output/job_shop.txt, unchanged.
import jobShopSvg from '../../captures/job-shop.svg?url';
import Diagram from '../components/Diagram.astro';

const mainRs = `let mut model = ModelBuilder::new();
let a = model.new_var("a", 1..=4);
let b = model.new_var("b", 1..=4);
model.add_all_different([a, b]);
model.add_minimize([a, b], 1);

let graph = model.build().expect("valid model");
let outcome = BranchAndBoundSolver::new().solve(&graph, &SolverOptions::default());`;
---

<Base>
  <Hero
    title="Model it in Rust. Solve it anytime."
    lead="unifier lets you state a problem as variables, domains, rules and goals, and finds the best answer it can: proven optimal when the search completes, the best so far when time runs out, and a clear Infeasible when no answer exists."
  >
    <Install commands={[{ label: 'cargo', command: 'cargo add unifier' }]} />
    <Badges>
      <Badge>MIT</Badge>
      <Badge tone="brand">early</Badge>
      {config.version && <Badge>crates.io {config.version}</Badge>}
      <Badge>Rust 1.87+</Badge>
    </Badges>
    <img
      slot="output"
      class="terminal-demo"
      src={jobShopSvg}
      width="444"
      height="278"
      alt="Terminal: cargo run -q --release --example job_shop prints Job shop: 3 jobs, 3 machines, horizon 21; Status: Optimal; Score: Feasible(strong=0, medium=0, weak=-11); Makespan: 11. Then one row per machine over the time steps 0 to 10, with digits for the job running: M0 00011......, M1 2222001111., M2 .....122200. Digits are job numbers; each row is one machine."
    />
  </Hero>

  <Features
    heading="Who it is for"
    items={[
      {
        title: 'Planning and scheduling',
        body: 'Jobs on machines, lessons in rooms, shifts for people: activities, resources and calendars compile into scheduling constraints that propagate.',
      },
      {
        title: 'Puzzles and assignments',
        body: 'Colour a map, place eight queens, pick one value per variable so that every rule holds. Hard rules must hold, soft goals are scored.',
      },
      {
        title: 'Rust code that must stop on time',
        body: 'Time limits, node budgets and a cancellation token end any solver with the best answer found so far, ready for a request handler or a UI.',
      },
    ]}
  />

  <section class="result" aria-labelledby="result-heading">
    <h2 id="result-heading">The job shop from the terminal, drawn</h2>
    <p class="intro">
      Three jobs, three machines, each job a fixed order of operations. unifier keeps every machine
      to one operation at a time, minimises the end of the last one and proves that 11 is the
      shortest possible. The chart is drawn from the output above.
    </p>
    <Diagram name="job-shop" format="svg" narrow={{ width: 380, height: 420 }} />
    <div class="links">
      <Button href={url('showcase/')} variant="secondary">All examples with their source</Button>
      <Button href={url('docs/guides/modelling/')} variant="quiet">Modelling guide →</Button>
    </div>
  </section>

  <Facts
    items={[
      { value: '5', label: 'interchangeable solver strategies' },
      { value: '17', label: 'built-in constraints, three of them global' },
      { value: '4', label: 'outcome states: Optimal, Feasible, Infeasible, Aborted' },
      { value: '1', label: 'runtime dependency (pathwise)' },
    ]}
  />

  <Features
    heading="What you get"
    items={[
      {
        title: 'Global constraints that propagate',
        body: 'AllDifferent, Cumulative and NoOverlap prune the search space before the search gets there, instead of only checking finished answers.',
      },
      {
        title: 'Honest results',
        body: 'Optimal only when Branch & Bound has proven it, Infeasible only when the search space is exhausted, Aborted with a reason otherwise, plus a bound that shows how far from proven a result is.',
      },
      {
        title: 'One model, five solvers',
        body: 'Backtracking, Branch & Bound, local search, large neighbourhood search and a parallel portfolio all solve the same validated model.',
      },
    ]}
  />

  <Quickstart
    lead="From a model to a proven optimum. The quickstart in the documentation walks through the full program and its output."
    steps={[
      'Add the crate with <code>cargo add unifier</code>.',
      'Declare variables, constraints and objectives with <code>ModelBuilder</code>.',
      'Validate with <code>build()</code>, then pass the graph to a solver.',
    ]}
  >
    <div class="qs">
      <CodeBlock code={mainRs} lang="rust" title="main.rs" label="Rust" />
      <Button href={url('docs/getting-started/quickstart/')} variant="secondary">Read the quickstart</Button>
    </div>
  </Quickstart>
</Base>

<style>
  .terminal-demo {
    display: block;
    width: 100%;
    max-width: 560px;
    height: auto;
    margin-inline: auto;
  }
  .result {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 24px 96px;
  }
  h2 {
    margin: 0 0 14px;
    color: var(--heading);
    font-size: 30px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .intro {
    max-width: 68ch;
    margin: 0 0 8px;
    font-size: 15.5px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  .qs {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    min-width: 0;
  }
  .qs > :global(*:first-child) {
    align-self: stretch;
  }
</style>
